<table width="100%" border="0" cellpadding="0" cellspacing="0" style="background-color: #f4f7f9; padding: 20px; font-family: 'Roboto', sans-serif;">
    <tr>
        <td align="center">
            <table width="600" border="0" cellpadding="0" cellspacing="0" style="background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 10px rgba(0,0,0,0.1);">
                <!-- Header -->
                <tr>
                    <td style="background-color: #7367f0; padding: 30px; text-align: center; color: #ffffff;">
                        <h1 style="margin: 0; font-size: 24px;"><%= __('Hello') %>, <%= userName %>!</h1>
                    </td>
                </tr>
                <!-- Content -->
                <tr>
                    <td style="padding: 40px; color: #333333; line-height: 1.6;">
                        <p style="font-size: 16px; margin-bottom: 20px;">
                            <%= __('Thank you for contacting us. Here is the reply to your inquiry:') %>
                        </p>
                        
                        <div style="background-color: #f8f9fa; border-left: 4px solid #7367f0; padding: 15px; margin-bottom: 25px;">
                            <p style="margin: 0; font-weight: bold; color: #7367f0;"><%= __('Your Message:') %></p>
                            <p style="margin: 5px 0 0 0; font-style: italic;"><%= data.message %></p>
                        </div>

                        <p style="font-size: 16px; font-weight: bold; margin-bottom: 10px;"><%= __('Our Reply:') %></p>
                        <p style="font-size: 16px; margin-bottom: 30px; white-space: pre-line;">
                            <%= data.reply %>
                        </p>

                        <p style="font-size: 14px; color: #777777;">
                            <%= __('If you have any further questions, please feel free to reach out to us again.') %>
                        </p>
                    </td>
                </tr>
                <!-- Footer -->
                <tr>
                    <td style="background-color: #f8f9fa; padding: 20px; text-align: center; color: #777777; font-size: 12px; border-top: 1px solid #eeeeee;">
                        <p style="margin: 0;">&copy; <%= new Date().getFullYear() %> <%= process.env.APP_NAME %>. <%= __('All rights reserved.') %></p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
