
<%- include('../partials/alert_message') %>
<div class="col-md-12">
    <div class="nav-align-top">
        <ul class="nav nav-pills flex-column flex-md-row mb-3 gap-md-0 gap-2" id="profile-tabs" role="tablist">
            <li class="nav-item">
                <a class="nav-link active" id="profile-tab" data-bs-toggle="pill" href="#profile-pane" role="tab" aria-controls="profile-pane" aria-selected="true">
                <i class="icon-base ti tabler-users icon-sm me-1_5"></i> <%= __('My Profile') %>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" id="security-tab" data-bs-toggle="pill" href="#security-pane" role="tab" aria-controls="security-pane" aria-selected="false">
                <i class="icon-base ti tabler-lock icon-sm me-1_5"></i> <%= __('Security') %>
                </a>
            </li>
        </ul>
    </div>

    <div class="tab-content">
        <!-- Profile Tab -->
        <div class="tab-pane fade show active" id="profile-pane" role="tabpanel" aria-labelledby="profile-tab">
            <div class="card mb-6">
                <div class="card-body">
                    <form id="formProfileUpdate" action="profile" method="POST" enctype="multipart/form-data" class="fv-plugins-bootstrap5 fv-plugins-framework">
                        <div class="col-sm-12 form-control-validation">
                            <div class="d-flex align-items-start align-items-sm-center gap-6 mb-3">
                                <img src="<%= admin.profileUrl %>" alt="<%= admin.name %>'s profile photo" class="d-block w-px-100 h-px-100 rounded" id="uploadedAvatar">
                                <div class="button-wrapper">
                                    <label for="upload" class="btn btn-primary me-3 mb-4 waves-effect waves-light" tabindex="0">
                                        <span class="d-none d-sm-block"><%= __('Upload new photo') %></span>
                                        <i class="icon-base ti tabler-upload d-block d-sm-none"></i>
                                        <input type="file" name="profile_image" id="upload" class="profile-file-input" hidden accept="image/png, image/jpeg, image/jpg, image/gif">
                                    </label>
                                    <button type="button" class="btn btn-label-secondary profile-image-reset mb-4 waves-effect">
                                        <i class="icon-base ti tabler-reset d-block d-sm-none"></i>
                                        <span class="d-none d-sm-block"><%= __('Reset') %></span>
                                    </button>
                                    <div><%= __('Allowed JPG, GIF or PNG. Max size of 2MB') %></div>
                                </div>
                            </div>
                        </div>

                        <div class="row gy-4 gx-6 mb-6">
                            <div class="col-md-6 form-control-validation fv-plugins-icon-container">
                                <label for="name" class="form-label">
                                    <%= __('Name') %><span class="text-danger">&nbsp;*</span>
                                </label>
                                <input class="form-control" type="text" id="name" name="name" value="<%= admin.name %>" placeholder="<%= __('Enter your name') %>">
                                <% if (errors && errors.name) { %>
                                <p style="color:red;"><%= errors.name %></p>
                                <% } %>
                            </div>

                            <div class="col-md-6 form-control-validation fv-plugins-icon-container">
                                <label for="email" class="form-label">
                                    <%= __('E-mail') %><span class="text-danger">&nbsp;*</span>
                                </label>
                                <input class="form-control" type="text" id="email" name="email" value="<%= admin.email %>" placeholder="<%= __('Enter your email') %>" readonly>
                                <div class="form-check form-switch mt-2">
                                    <input type="checkbox" class="form-check-input" id="emailChange" name="email_change" value="true" />
                                    <label for="emailChange" class="form-check-label"><%= __('Allow email change') %></label>
                                </div>
                                <% if (errors && errors.email) { %>
                                <p style="color:red;"><%= errors.email %></p>
                                <% } %>
                            </div>

                            <div class="col-md-6 form-control-validation fv-plugins-icon-container">
                                <label class="form-label" for="phone">
                                    <%= __('Phone Number') %><span class="text-danger">&nbsp;*</span>
                                </label>
                                <%- include('../partials/mobile-field', { 
                                    type: 'tel', 
                                    value: admin.phone, 
                                    placeholder: __('Phone Number'), 
                                    id: 'phone', 
                                    name: 'phone' 
                                }) %>
                            </div>

                            <!-- <div class="col-md-6 form-control-validation fv-plugins-icon-container">
                                <label class="form-label" for="phone"><%= __('Phone Number') %></label>
                                    <div class="input-group input-group-merge">
                                    <span class="input-group-text">SA (+966)</span>
                                    <input class="form-control" type="text" id="phone" name="phone" value="<%= admin.phone %>" placeholder="<%= __('Enter your phone number') %>">
                                    <% if (errors && errors.phone) { %>
                                    <p style="color:red;"><%= errors.phone %></p>
                                    <% } %>
                                </div>
                            </div> -->
                        </div>

                        <div class="mt-2">
                        <button type="submit" class="btn btn-primary me-3 waves-effect waves-light"><%= __('Save changes') %></button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Security Tab -->
        <div class="tab-pane fade" id="security-pane" role="tabpanel" aria-labelledby="security-tab">
            <div class="card mb-6">
                <h5 class="card-header"><%= __('Change Password') %></h5>
                <div class="card-body pt-1">
                    <form id="formChangePassword" action="change-password" method="POST">
                        <div class="row mb-sm-6 mb-2">
                            <div class="col-md-6 form-password-toggle form-control-validation">
                                <label class="form-label" for="currentPassword"><%= __('Current Password') %></label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="password" name="currentPassword" id="currentPassword" placeholder="************" />
                                    <span class="input-group-text cursor-pointer"><i class="icon-base ti tabler-eye-off"></i></span>
                                </div>
                            </div>
                        </div>

                        <div class="row gy-sm-6 gy-2 mb-sm-0 mb-2">
                            <div class="mb-6 col-md-6 form-password-toggle form-control-validation">
                                <label class="form-label" for="newPassword"><%= __('New Password') %></label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="password" id="newPassword" name="newPassword" placeholder="************" />
                                    <span class="input-group-text cursor-pointer"><i class="icon-base ti tabler-eye-off"></i></span>
                                </div>
                            </div>

                            <div class="mb-6 col-md-6 form-password-toggle form-control-validation">
                                <label class="form-label" for="confirmPassword"><%= __('Confirm New Password') %></label>
                                <div class="input-group input-group-merge">
                                    <input class="form-control" type="password" name="confirmPassword" id="confirmPassword" placeholder="************" />
                                    <span class="input-group-text cursor-pointer"></span>
                                </div>
                            </div>
                        </div>

                        <h6 class="text-body"><%= __('Password Requirements:') %></h6>
                        <ul class="ps-4 mb-0">
                            <li class="mb-4"><%= __('Minimum 8 characters long - the more, the better') %></li>
                            <li class="mb-4"><%= __('At least one lowercase character') %></li>
                            <li><%= __('At least one number, symbol, or whitespace character') %></li>
                        </ul>

                        <div class="mt-6">
                        <button type="submit" class="btn btn-primary me-3"><%= __('Save changes') %></button>
                        <!-- <button type="reset" class="btn btn-label-secondary">Reset</button> -->
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script src="assets/js/pages/profile/profile.js"></script>